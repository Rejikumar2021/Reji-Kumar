<div class="custom-grid-container">
   <div class="product-grid-title">
    <p>{{ section.settings.section_title }}</p>
   </div>
   <div class="product-grid-wrapper">
    {% for product in section.settings.selected_products %}
    <div class="product-item">
        <a href="#" data-id ="{{ product.id }}" data-handle="{{ product.handle }}">
           {{ product.featured_image | image_url: width:1200 | image_tag:class :"full-width-auto"  }}
        </a>
    </div>
    {% endfor %}
   </div>

   <div class="product-popup">
    <div class="product-popup-body">
        <a href="#" class="close-popup"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.0376 4.94354L13.5229 13.4288" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M5.0376 13.4285L13.5229 4.94325" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
</a>
       <div class="product-image-info-container">

        <div class="product-image"></div>
        <div class="product-info">
            <div class="product-title"></div>
            <div class="product-price"></div>
            <div class="product-description"></div>
        </div>
       </div>

       <div class="product-color-container"></div>
       <div class="product-size-container"></div>
       <div class="add-to-cart-container"></div>

    </div>

   </div>


</div>



<style>
    .custom-grid-container
    {
        width: 100%;
        max-width: 1440px;
        margin: 0px auto;
        padding:0px 16px;
        margin-top:30px;
        margin-bottom:30px;
    }
    .product-grid-wrapper 
    {
        display:flex;
        flex-wrap:wrap;
        flex-direction: row;
    }
    .product-item 
    {
        width:50%;
    }
    .product-item img 
    {
        width:100%;
        height:auto;   
        padding:2px;
    }
    .product-popup 
    {
        position:fixed;
        padding:0;
        margin:0;
        top:0;
        left:0;
        width:100%;
        height:100%;
        background:#bfbfbf5c;
        z-index:9;
        display:none;
        
    }
    .product-popup-body
    {
        width:331px;
        height:447px;
        top:20%;
        margin:0px auto;
        position:relative;
        background-color:#ffffff;
        padding:36px 20px 25px 20px;
    }
    .close-popup 
    {
        position: absolute;
        right: 0;
        margin-right: 15px;
        text-decoration: none;
        font-family: 'Jost';
        color: #000;
        font-size: 19px;
        margin-top: -30px;
    }
    .product-image-info-container 
    {
        display: flex;
        flex-direction: row;
        gap: 8px;
    }
    .product-image-info-container .product-image
    {
        width:100%;
        min-width:120px;
    }
    .product-image-info-container .product-image img 
    {
        height: 100%;
        object-fit: cover;
    }
     .product-image-info-container .product-title 
    {
        font-family: 'Jost';
        font-weight: 300;
        font-size: 16px;
        line-height: 120%;
        color: #000;
        margin-bottom:20px;
    }
     .product-image-info-container .product-description p 
    {
        font-size: 14px;
        font-weight: 300;
        color: #000;
        line-height: 110%;
        margin:unset;
    }
     .product-image-info-container .product-info 
     {
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: flex-start;
        }
    .product-price 
    {
        margin-bottom:12px;
    }

      @media (min-width: 1025px) {
    
    .product-item 
    {
        width:33%;
        margin-bottom: -25px;
    }
       .product-item img 
       {
        padding:20px;
    }

    }
</style>
<script>
document.addEventListener("DOMContentLoaded",()=>{

    document.querySelectorAll('.product-item').forEach(function(item){

        item.addEventListener('click',function(e){
        e.preventDefault();
        document.querySelector('.product-image').innerHTML = "";
        document.querySelector('.product-title').innerHTML = "";
        document.querySelector('.product-price').innerHTML = "";
        document.querySelector('.product-description').innerHTML = "";
        

        let productId = this.querySelector('a').getAttribute('data-id');
        let ProductHandle = this.querySelector('a').getAttribute('data-handle');
        let productDetails = fetch(`/products/${ProductHandle}.js`).then(res=>res.json());
        

        
        productDetails.then(product => {
            
            document.querySelector('.product-image').innerHTML = `<img src=${product.images[0]} alt="${product.title}" style="max-width:100%">`;
            document.querySelector('.product-title').innerHTML = product.title;
            document.querySelector('.product-price').innerHTML = (product.price / 100).toLocaleString('en-US',{style:'currency',currency:Shopify.currency.active});
             document.querySelector('.product-description').innerHTML = product.description;

        });



        document.querySelector('.product-popup ').style.display="block";

        })
    
    })

    document.querySelector('.close-popup').addEventListener('click',function(e){
    e.preventDefault();
     document.querySelector('.product-popup ').style.display="none";
    });

})

</script>

{% schema %}
{

"name":"Custom Product Grid",
"settings":[
{
    "type": "product_list",
    "id": "selected_products",
    "label": "Select Product"
},
{
    "type": "text",
    "id":"section_title",
    "label": "Section Title"
}

],
"presets":[
{
    "name":"Custom Product Grid"
}

]

}

{% endschema %}