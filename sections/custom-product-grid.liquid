<div class="custom-grid-container">
   <div class="product-grid-title">
    <p>{{ section.settings.section_title }}</p>
   </div>
   <div class="product-grid-wrapper">
    {% for product in section.settings.selected_products %}
    <div class="product-item">
        <a href="#" data-id ="{{ product.id }}" data-handle="{{ product.handle }}">
           {{ product.featured_image | image_url: width:1200 | image_tag:class :"full-width-auto"  }}
        </a>
    </div>
    {% endfor %}
   </div>

   <div class="product-popup">
    <div class="product-popup-body">
        <input type="hidden" id="selected-product-size">
        <input type="hidden" id="selected-product-color">
        
        <a href="#" class="close-popup"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.0376 4.94354L13.5229 13.4288" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M5.0376 13.4285L13.5229 4.94325" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
</a>
       <div class="product-image-info-container">

        <div class="product-image"></div>
        <div class="product-info">
            <div class="product-title"></div>
            <div class="product-price"></div>
            <div class="product-description"></div>
        </div>
       </div>

       <div class="product-color-container">
        <p>Color</p>
       </div>
       <div class="product-size-container">
         <p>Size</p>
        <select id="product-size">
            <option value="">----------</option>
        </select>

       </div>
       <div class="add-to-cart-container">
        <button id="add-to-cart">ADD TO CART <svg width="28" height="13" viewBox="0 0 28 13" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.11108 5.74396L0.361084 5.74396L0.361084 7.24396L1.11108 7.24396L1.11108 5.74396ZM27.1487 7.02429C27.4416 6.7314 27.4416 6.25652 27.1487 5.96363L22.3757 1.19066C22.0828 0.897765 21.6079 0.897765 21.315 1.19066C21.0221 1.48355 21.0221 1.95843 21.315 2.25132L25.5577 6.49396L21.315 10.7366C21.0221 11.0295 21.0221 11.5044 21.315 11.7973C21.6079 12.0902 22.0828 12.0902 22.3757 11.7973L27.1487 7.02429ZM1.11108 7.24396L26.6183 7.24396L26.6183 5.74396L1.11108 5.74396L1.11108 7.24396Z"></path>
            </svg></button>
       </div>

    </div>

   </div>


</div>



<style>
    .custom-grid-container
    {
        width: 100%;
        max-width: 1440px;
        margin: 0px auto;
        padding:0px 16px;
        margin-top:30px;
        margin-bottom:30px;
    }
    .product-grid-wrapper 
    {
        display:flex;
        flex-wrap:wrap;
        flex-direction: row;
    }
    .product-item 
    {
        width:50%;
    }
    .product-item img 
    {
        width:100%;
        height:auto;   
        padding:2px;
    }
    .product-popup 
    {
        position:fixed;
        padding:0;
        margin:0;
        top:0;
        left:0;
        width:100%;
        height:100%;
        background:#bfbfbf5c;
        z-index:9;
        display:none;
        
    }
    .product-popup-body
    {
        width:331px;
        height:475px;
        top:20%;
        margin:0px auto;
        position:relative;
        background-color:#ffffff;
        padding:36px 20px 25px 20px;
    }
    .close-popup 
    {
        position: absolute;
        right: 0;
        margin-right: 15px;
        text-decoration: none;
        font-family: 'Jost';
        color: #000;
        font-size: 19px;
        margin-top: -30px;
    }
    .product-image-info-container 
    {
        display: flex;
        flex-direction: row;
        gap: 8px;
    }
    .product-image-info-container .product-image
    {
        width:100%;
        min-width:120px;
    }
    .product-image-info-container .product-image img 
    {
        height: 100%;
        object-fit: cover;
    }
     .product-image-info-container .product-title 
    {
        font-family: 'Jost';
        font-weight: 300;
        font-size: 16px;
        line-height: 120%;
        color: #000;
        margin-bottom:20px;
    }
     .product-image-info-container .product-description p 
    {
        font-size: 14px;
        font-weight: 300;
        color: #000;
        line-height: 110%;
        margin:unset;
    }
     .product-image-info-container .product-info 
     {
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: flex-start;
        }
    .product-price 
    {
