    }
    .product-size-container select 
    {
        width: 100%;
        padding-top: 10px;
        padding-bottom: 10px;
        font-size: 16px;
        outline:none;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background-image:
    url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" stroke="%23666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>');
  background-repeat: no-repeat;
  background-position: right .7rem center;
  background-size: 14px 14px;
  padding-left:13px;
    }
     .product-size-container select:focus 
     {
        outline:none;
    }
    .product-size-container::after
    {
        content: "|";
        position: absolute;
        font-size: 39px;
        margin-top: -19px;
        right: 50px;
        color: #767676;
    }
    .add-to-cart-container button svg 
    {
        fill:#ffffff;
        margin-left:15px;
    }
    .add-to-cart-container 
    {
        display: flex;
        justify-content: center;
        margin-top: 35px;
    }
    .add-to-cart-container button 
    {
        background-color: #000;
        color: #fff;
        border: 1px solid #000;
        padding: 12px 55px 12px 95px;
        cursor:pointer;
    }
      @media (min-width: 1025px) {
    
    .product-item 
    {
        width:33%;
        margin-bottom: -25px;
    }
       .product-item img 
       {
        padding:20px;
    }

    }
</style>
<script>
document.addEventListener("DOMContentLoaded",()=>{

    document.querySelectorAll('.product-item').forEach(function(item){

        item.addEventListener('click',function(e){
        e.preventDefault();
        document.querySelector('.product-image').innerHTML = "";
        document.querySelector('.product-title').innerHTML = "";
        document.querySelector('.product-price').innerHTML = "";
        document.querySelector('.product-description').innerHTML = "";
        

        let productId = this.querySelector('a').getAttribute('data-id');
        let ProductHandle = this.querySelector('a').getAttribute('data-handle');
        let productDetails = fetch(`/products/${ProductHandle}.js`).then(res=>res.json());
        let colorContainer = document.querySelector('.product-color-container');
             colorContainer.innerHTML = `<p>Color</p>`;
        let productOption = document.querySelector('.product-size-container select');

        

        
        productDetails.then(product => {
            
            document.querySelector('.product-image').innerHTML = `<img src=${product.images[0]} alt="${product.title}" style="max-width:100%">`;
            document.querySelector('.product-title').innerHTML = product.title;
            document.querySelector('.product-price').innerHTML = (product.price / 100).toLocaleString('en-US',{style:'currency',currency:Shopify.currency.active});
             document.querySelector('.product-description').innerHTML = product.description;

             const optionMap = {};
            product.options.forEach((opt,index)=>{
                optionMap[opt.name.toLowerCase()] = index;
            });
            const colorIdx = optionMap["color"];
            const sizeIdx = optionMap["size"];

             const colors = [...new Set(product.variants.map(v => v.options[colorIdx]))];

            colors.forEach(color =>{
            const colorWrapper = document.createElement("div"); 
             const btn = document.createElement("button");
             colorWrapper.classList.add("color-container");
             btn.textContent = color;
             btn.dataset.color = color;
             btn.classList.add("color-btn");
            colorWrapper.style.backgroundColor = color;
            colorWrapper.appendChild(btn);
            colorContainer.appendChild(colorWrapper);
            btn.addEventListener("click",()=>{
                
                productOption.innerHTML = "";
                let defaultOption = document.createElement('option');
                    defaultOption.value = "";
                    defaultOption.textContent = "Choose your size";
                    productOption.appendChild(defaultOption);

                    document.querySelectorAll('.color-btn').forEach(btn =>{
                    btn.style.backgroundColor = "#ffffff"
                    btn.style.color = "#000"
                    });
                    if(color !="White")
                    {
                         btn.style.backgroundColor = color;
                         btn.style.borderColor = color;
                        btn.style.color = "#fff";
                    }
                    
                    showSizes(color);

            });
                
            });

            function showSizes(color){
               
                let sizeAvailable = product.options[sizeIdx].values.map(sizeValue => {
                const variant = product.variants.find(
                    v=>v.options[colorIdx] === color && v.options[sizeIdx] === sizeValue
                );
                return {
                    size : sizeValue,
                    id : variant ? variant.id : null,
                    available : variant ? variant.available : false
                }
                })

                sizeAvailable.forEach(product =>{

                    if(product.id !=null && product.available != false){
                    
                        const option = document.createElement('option');
                        option.value = product.id;
                        option.textContent = product.size;
                        productOption.appendChild(option);

                    }
                
                });

            
            }

             document.querySelector('.product-popup ').style.display="block";

        });

        });
    
    });

    document.querySelector('.close-popup').addEventListener('click',function(e){
    e.preventDefault();
     document.querySelector('.product-popup ').style.display="none";
    });

    document.getElementById('product-size').addEventListener('change',function(){
    
        const selectedVariantId = this.value;
        const selectedOptionText = this.options[this.selectedIndex].text;
         


    });

})

</script>

{% schema %}
{

"name":"Custom Product Grid",
"settings":[
{
    "type": "product_list",
    "id": "selected_products",
    "label": "Select Product"
},
{
    "type": "text",
    "id":"section_title",
    "label": "Section Title"
}

],
"presets":[
{
    "name":"Custom Product Grid"
}

]

}

{% endschema %}